name: Yakka

cpp_standard: c++23

sources:
  - build_request.cpp
  - build_session.cpp
  - yakka_project.cpp
  - project_diff.cpp
  - file_check.cpp
  - yakka_component.cpp
  - yakka_workspace.cpp
  - component_database.cpp
  - target_database.cpp
  - yakka_blueprint.cpp
  - blueprint_database.cpp
  - blueprint_commands.cpp
  - utilities.cpp
  - task_engine.cpp
  - ninja_generator.cpp
  - ninja_runner.cpp
  - legacy_fast_path.cpp
  - yakka_schema.cpp

includes:
  global:
    - '.'

requires:
  components:
    - cpp-subprocess
    - inja
    - json
    - cpp-semver
    - indicators
    - cxxopts
    - spdlog
    - taskflow
    - glob
#    - json-schema-validator
    - rapidyaml
    - rapidyaml_json
    - rapidtoml
    - blake3
    - libsodium
    - pugixml
    - valijson
    - ninja
    - pcre2

features:
  timestamp_file_checks:
    defines:
      global:
        - YAKKA_FILE_CHECK_TIMESTAMP=1

supports:
  components:
    gcc:
      flags:
        cpp:
          global:
          - -Wno-error=sign-compare
    xcode:
      flags:
        cpp:
          global:
            - -Wno-deprecated-declarations
