name: PCRE2
version: 10.49.0
description: PCRE2 8-bit regular expression library (BSD-3-Clause WITH PCRE2-exception)

sources:
  - pcre2-10.49/src/pcre2_auto_possess.c
  - generated/pcre2_chartables.c
  - pcre2-10.49/src/pcre2_chkdint.c
  - pcre2-10.49/src/pcre2_compile.c
  - pcre2-10.49/src/pcre2_compile_cgroup.c
  - pcre2-10.49/src/pcre2_compile_class.c
  - pcre2-10.49/src/pcre2_config.c
  - pcre2-10.49/src/pcre2_context.c
  - pcre2-10.49/src/pcre2_convert.c
  - pcre2-10.49/src/pcre2_dfa_match.c
  - pcre2-10.49/src/pcre2_error.c
  - pcre2-10.49/src/pcre2_extuni.c
  - pcre2-10.49/src/pcre2_find_bracket.c
  - pcre2-10.49/src/pcre2_jit_compile.c
  - pcre2-10.49/src/pcre2_maketables.c
  - pcre2-10.49/src/pcre2_match.c
  - pcre2-10.49/src/pcre2_match_data.c
  - pcre2-10.49/src/pcre2_match_next.c
  - pcre2-10.49/src/pcre2_newline.c
  - pcre2-10.49/src/pcre2_ord2utf.c
  - pcre2-10.49/src/pcre2_pattern_info.c
  - pcre2-10.49/src/pcre2_script_run.c
  - pcre2-10.49/src/pcre2_serialize.c
  - pcre2-10.49/src/pcre2_string_utils.c
  - pcre2-10.49/src/pcre2_study.c
  - pcre2-10.49/src/pcre2_substitute.c
  - pcre2-10.49/src/pcre2_substring.c
  - pcre2-10.49/src/pcre2_tables.c
  - pcre2-10.49/src/pcre2_ucd.c
  - pcre2-10.49/src/pcre2_valid_utf.c
  - pcre2-10.49/src/pcre2_xclass.c

includes:
  global:
    - generated
  local:
    - pcre2-10.49/src

defines:
  global:
    - PCRE2_STATIC
    - PCRE2_CODE_UNIT_WIDTH=8
  local:
    - HAVE_CONFIG_H
    - SUPPORT_PCRE2_8
    - SUPPORT_UNICODE
    - HAVE_MEMMOVE
    - HAVE_STDINT_H
    - HAVE_STDLIB_H
    - HAVE_STRING_H
    - HAVE_LIMITS_H
    - HAVE_INTTYPES_H
