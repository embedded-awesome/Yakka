name: xcode toolchain

toolchain:
  name: xcode

# choices:
#   cpp_standard:
#     description: Select the C++ standard to use
#     data: '/toolchain/cpp_standard'
#     options:
#       - c++2c
#       - c++26
#       - c++23
#       - c++20
#       - c++17
#       - c++14
#       - c++11
#       - c++98
#     default: c++23

#   c_standard:
#     description: Select the C standard to use
#     data: '/toolchain/c_standard'
#     options:
#       - c23
#       - c18
#       - c17
#       - c11
#       - c99
#       - c90
#     default: c18

toolchain:
  cpp_standard: c++23
  c_standard: c18

flags:
  c:
    global:
      - --target=arm64-apple-darwin
      - -Os
      - -MD
      - -ffunction-sections
      - -fdata-sections

  cpp:
    global:
      - --target=arm64-apple-darwin
      - -O3
      - -MD
      - -ffunction-sections
      - -fdata-sections
      - -Werror -Wpedantic -Wall
      - -Wno-deprecated-literal-operator
      - -g
      - -std=c++23 # Temporary hardcoded C++ standard, should be replaced with selected option from choices

  ld:
    global: 
      - --target=arm64-apple-darwin
      - -O3
      - -lpthread
      - -dead_strip
      - -g

data_schema:
  toolchain:
    properties:
      cpp_standard:
        merge_strategy: max
        type: "string"
        enum:
          - c++2c
          - c++26
          - c++23
          - c++20
          - c++17
          - c++14
          - c++11
          - c++98
      c_standard:
        merge_strategy: max
        type: "string"
        enum:
          - c23
          - c18
          - c17
          - c11
          - c99
          - c90

tools:
  clang++: clang++
  clang: clang
  clang_cpp: clang++
  clang_c: clang

blueprints:
  link:
    depends:
      - '{{project_output}}/{{project_name}}{{configuration.executable_extension}}'

  '{{project_output}}/{{project_name}}{{configuration.executable_extension}}':
    depends:
      - '[{% for name, component in components %}{%if existsIn(component,"sources") %}{% for source in component.sources %}{{project_output}}/components/{{name}}/{{source}}.o, {% endfor %}{% endif %}{% endfor %}]'
      - '{{project_output}}/{{project_name}}.global_ld_options'
    process:
      - clang++: "@{{project_output}}/{{project_name}}.global_ld_options -o {{$(0)}}"

  c_object_files:
    regex: .+/components/([^/]*)/(.*)\.(S|c)\.o
    depends:
      - '{{project_output}}/components/{{$(1)}}/{{$(1)}}.c_options'
      - '{{at(components, $(1)).directory}}/{{$(2)}}.{{$(3)}}'
      - '{{project_output}}/{{project_name}}.global_c_options'
      - dependency_file: '{{project_output}}/components/{{$(1)}}/{{$(2)}}.{{$(3)}}.d'
    process:
      - create_directory: '{{$(0)}}'
      - execute: '{{at(tools, "clang_c")}} -c @{{project_output}}/{{project_name}}.global_c_options @{{project_output}}/components/{{$(1)}}/{{$(1)}}.c_options -o {{$(0)}} {{at(components, $(1)).directory}}/{{$(2)}}.{{$(3)}}'
  
  cpp_object_files:
    regex: .+/components/([^/]*)/(.*)\.(cpp|cc)\.o
    depends:
      - '{{project_output}}/components/{{$(1)}}/{{$(1)}}.cpp_options'
      - '{{at(components, $(1)).directory}}/{{$(2)}}.{{$(3)}}'
      - '{{project_output}}/{{project_name}}.global_cpp_options'
      - dependency_file: '{{project_output}}/components/{{$(1)}}/{{$(2)}}.{{$(3)}}.d'
    process:
      - create_directory: '{{$(0)}}'
      - execute: '{{at(tools, "clang_cpp")}} -c @{{project_output}}/{{project_name}}.global_cpp_options @{{project_output}}/components/{{$(1)}}/{{$(1)}}.cpp_options -o {{$(0)}} {{at(components, $(1)).directory}}/{{$(2)}}.{{$(3)}}'
  
  S_object_files:
    regex: .+/components/([^/]*)/(.*)\.S\.o
    depends:
      - '{{project_output}}/components/{{$(1)}}/{{$(1)}}.c_options'
      - '{{project_output}}/components/{{$(1)}}/{{$(1)}}.S_options'
      - '{{at(components, $(1)).directory}}/{{$(2)}}.S'
      - '{{project_output}}/{{project_name}}.global_c_options'
      - '{{project_output}}/{{project_name}}.global_S_options'
      - dependency_file: '{{project_output}}/components/{{$(1)}}/{{$(2)}}.S.d'
    process:
      - create_directory: '{{$(0)}}'
      - execute: '{{tools.clang_c}} @{{project_output}}/{{project_name}}.global_c_options @{{project_output}}/{{project_name}}.global_S_options @{{project_output}}/components/{{$(1)}}/{{$(1)}}.c_options @{{project_output}}/components/{{$(1)}}/{{$(1)}}.S_options -o {{$(0)}} -c {{at(components, $(1)).directory}}/{{$(2)}}.S'
  
  '{{project_output}}/{{project_name}}.global_ld_options':
    depends:
      - data:
          - '/*/flags/ld'
          - ':/components/*/sources'
          - ':/components/xcode/blueprints'
    process:
      - inja: "{% for name,component in components %}{% for flag in component.flags.ld.global %}{{flag}} {% endfor %}{%endfor%} {% for name, component in components %}{%if existsIn(component,\"sources\") %}{% for source in component.sources %}{{project_output}}/components/{{name}}/{{source}}.o {% endfor %}{% endif %}{% endfor %}"
      - save: 
    
  global_compiler_options:
    regex: '{{project_output}}/{{project_name}}.global_(cpp|c|S)_options'
    depends:
      - data:
          - '/*/flags/{{$(1)}}/global'
          - '/*/includes/global'
          - '/*/defines/global'
    process:
      - inja: |-
          {% for name,component in components -%}
          {%   if existsIn(component, "flags") and existsIn(component.flags, $(1)) -%}
          {%     for flag in at(component.flags, $(1)).global -%}
          {{flag}}
          {%     endfor -%}
          {%   endif -%}
          {%-   for include in component.includes.global -%}
          -I{{component.directory}}/{{include}}
          {%   endfor -%}
          {%-   for define in component.defines.global -%}
          -D{{render(define, component.directory)}}
          {%   endfor -%}
          {% endfor -%}
          -std={% if $(1) == "cpp" %}{{ data.toolchain.cpp_standard }}{% else %}{{ data.toolchain.c_standard }}{% endif %}
          {%- for feature in features %}-D{{feature}}_FEATURE_REQUIRED {% endfor %}
          -I{{project_output}}
      - save: 
      
  compiler_option_files:
    regex: '.+/components/([^/]*)/\1\.(cpp|c|S)_options'
    depends:
      - data:
          - '/{{$(1)}}/flags/{{$(2)}}/local'
          - '/{{$(1)}}/includes/local'
          - '/{{$(1)}}/defines/local'
    process:
      - create_directory: '{{$(0)}}'
      - inja: |
          {% set component=at(components,$(1)) %}
          {% if existsIn(component, "flags")%}{% for flag in at(component.flags, $(2)).local %}{{flag}} {% endfor %}{% endif %}
          -std={% if $(2) == "cpp" %}{{ data.toolchain.cpp_standard }}{% else %}{{ data.toolchain.c_standard }}{% endif %}
          {% for include in component.includes.local %}-I{{component.directory}}/{{include}} {% endfor %}
          {% for define in component.defines.local %}-D{{define}} {% endfor %}
      - save:
